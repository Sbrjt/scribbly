server {
    listen 80;

    location /api/post/ {
        proxy_pass http://post_service/;
    }

    location /api/auth/ {
        proxy_pass http://auth_service/;
    }

    location /api/user/ {
        proxy_pass http://user_service/;
    }

    location / {
        proxy_pass http://web/;
    }

    # for hot reload in next
    location /_next/ {
        proxy_pass http://web;
        include /etc/nginx/websocket.conf;
    }
}
